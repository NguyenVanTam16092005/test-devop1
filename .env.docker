# .env Template
# Copy this file to .env and fill in your actual values

# Backend Configuration
BACKEND_PORT=8081
NODE_ENV=development
MONGODB_URI=mongodb://admin:admin123@mongo:27017/student-management?authSource=admin

# Frontend Configuration  
FRONTEND_PORT=80
VITE_API_URL=http://localhost:8081

# MongoDB Configuration
MONGO_PORT=27017
MONGO_USERNAME=admin
MONGO_PASSWORD=admin123

# Docker Hub Configuration
DOCKER_HUB_USERNAME=your-dockerhub-username
DOCKER_HUB_PASSWORD=your-dockerhub-password

# Container Names
BACKEND_CONTAINER_NAME=student-management-backend
FRONTEND_CONTAINER_NAME=student-management-frontend
MONGO_CONTAINER_NAME=student-management-mongo

# Docker Image Tags
DOCKER_TAG=latest
